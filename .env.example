# GEMINI_API_KEY: Required for Gemini AI API calls (/api/analyze, /api/ask).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional override for the Gemini model name used by the server.
GEMINI_MODEL="gemini-4-hydrogen"

# PORT: Optional server port (defaults to 3000).
PORT=3000

# SESSION_SECRET: Strong random string for signing HTTP-only auth cookies.
SESSION_SECRET="change-me-to-a-long-random-secret"

# ADMIN_EMAIL / ADMIN_PASSWORD: Initial administrator account credentials.
ADMIN_EMAIL="admin@datainsight.pro"
ADMIN_PASSWORD="ChangeMeAdmin123!"

# DATABASE_URL: Optional PostgreSQL connection string (Render / Neon / Supabase).
DATABASE_URL=""

# VIVA.COM SMART CHECKOUT (Cards + Automatic Greek IRIS + Apple/Google Pay)
VIVA_CLIENT_ID=""
VIVA_CLIENT_SECRET=""
VIVA_SOURCE_CODE=""
VIVA_WEBHOOK_KEY=""
VIVA_DEMO_MODE="false"

# STRIPE (Cards + Subscriptions + Apple/Google Pay)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# DEFAULT DIRECT IRIS & WEB BANKING DETAILS (can also be edited anytime inside Admin Panel)
BANK_NAME=""
BANK_IBAN=""
BANK_BENEFICIARY=""
BANK_BIC=""
IRIS_IDENTIFIER=""
IRIS_RECIPIENT_NAME=""

# APP_URL: Public base URL used for checkout redirect URLs
APP_URL="http://localhost:3000"
